{
  "annotations": { "list": [] },
  "title": "NEXUS — API Overview",
  "tags": ["nexus"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Requests/sec",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexus_http_requests_total[1m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "title": "Request Latency (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nexus_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "title": "Inferences by Label",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(nexus_inference_total[1m])) by (label)",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "title": "Inference Latency (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nexus_inference_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "inference p95"
        }
      ]
    },
    {
      "title": "Feedback (up vs down)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(nexus_feedback_total) by (feedback_type)",
          "legendFormat": "{{feedback_type}}"
        }
      ]
    },
    {
      "title": "Active Experiments",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        { "expr": "nexus_experiments_active" }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
